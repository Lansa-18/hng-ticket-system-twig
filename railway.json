{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "composer install && npm install && npm run build"
  },
  "deploy": {
    "startCommand": "php -S \"0.0.0.0:${PORT}\" -t public/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
