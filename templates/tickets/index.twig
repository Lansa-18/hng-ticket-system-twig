{% extends "base.twig" %}

{% block content %}
<div class="container mx-auto px-6 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-semibold text-gray-800">Tickets</h1>
        <button onclick="openNewTicketModal()" class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition-colors">
            Create New Ticket
        </button>
    </div>

    <!-- Filters -->
    <div class="mb-6 bg-white p-4 rounded-lg shadow">
        <div class="flex flex-wrap gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-medium text-gray-700">Search</label>
                <input type="text" id="searchInput" placeholder="Search tickets..." 
                       class="mt-1 block w-full px-4 py-2 text-gray-900 bg-white border rounded-md border-gray-300 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Status</label>
                <select id="statusFilter" class="mt-1 block w-full px-4 py-2 text-gray-900 bg-white border rounded-md border-gray-300 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:text-sm">
                    <option value="">All</option>
                    <option value="open">Open</option>
                    <option value="in_progress">In Progress</option>
                    <option value="closed">Closed</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Tickets List -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="grid gap-6 p-6" id="ticketsList">
            <!-- Tickets will be loaded here -->
        </div>
    </div>
</div>

<!-- New/Edit Ticket Modal -->
<div id="ticketModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <h3 class="text-lg font-medium text-gray-900 mb-4" id="modalTitle">Create New Ticket</h3>
            <form id="ticketForm" class="space-y-4">
                <input type="hidden" name="id" id="ticketId">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Title</label>
                    <input type="text" name="title" required 
                           class="mt-1 block w-full px-4 py-2 text-gray-900 bg-white border rounded-md border-gray-300 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:text-sm">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Description</label>
                    <textarea name="description" rows="3" 
                              class="mt-1 block w-full px-4 py-2 text-gray-900 bg-white border rounded-md border-gray-300 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:text-sm"></textarea>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Status</label>
                    <select name="status" required 
                            class="mt-1 block w-full px-4 py-2 text-gray-900 bg-white border rounded-md border-gray-300 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 sm:text-sm">
                        <option value="open">Open</option>
                        <option value="in_progress">In Progress</option>
                        <option value="closed">Closed</option>
                    </select>
                </div>
                <div class="flex justify-end space-x-3">
                    <button type="button" onclick="closeTicketModal()" 
                            class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300">
                        Cancel
                    </button>
                    <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">
                        Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3 text-center">
            <h3 class="text-lg font-medium text-gray-900">Delete Ticket</h3>
            <div class="mt-2 px-7 py-3">
                <p class="text-sm text-gray-500">
                    Are you sure you want to delete this ticket? This action cannot be undone.
                </p>
            </div>
            <div class="flex justify-center space-x-4 mt-4">
                <button onclick="closeDeleteModal()" 
                        class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300">
                    Cancel
                </button>
                <button onclick="confirmDelete()" 
                        class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700">
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
let ticketToDelete = null;

document.addEventListener('DOMContentLoaded', function() {
    // Check authentication
    const session = localStorage.getItem('ticketapp_session');
    if (!session) {
        window.location.href = '/login';
        return;
    }

    // Load tickets
    loadTickets();

    // Add event listeners
    document.getElementById('searchInput').addEventListener('input', loadTickets);
    document.getElementById('statusFilter').addEventListener('change', loadTickets);
});

function loadTickets() {
    let tickets = JSON.parse(localStorage.getItem('tickets')) || [];
    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    const statusFilter = document.getElementById('statusFilter').value;

    // Apply filters
    tickets = tickets.filter(ticket => {
        const matchesSearch = ticket.title.toLowerCase().includes(searchTerm) || 
                            ticket.description.toLowerCase().includes(searchTerm);
        const matchesStatus = !statusFilter || ticket.status === statusFilter;
        return matchesSearch && matchesStatus;
    });

    // Sort by creation date (newest first)
    tickets.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));

    // Update UI
    const ticketsList = document.getElementById('ticketsList');
    if (tickets.length === 0) {
        ticketsList.innerHTML = '<p class="text-center text-gray-500">No tickets found</p>';
        return;
    }

    ticketsList.innerHTML = tickets.map(ticket => `
        <div class="bg-white border rounded-lg p-6 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-lg font-medium text-gray-900">${ticket.title}</h3>
                    <p class="mt-1 text-sm text-gray-500">${ticket.description || 'No description'}</p>
                </div>
                <span class="px-2 py-1 text-xs rounded-full ${getStatusClass(ticket.status)}">
                    ${ticket.status}
                </span>
            </div>
            <div class="mt-4 flex justify-between items-center">
                <span class="text-sm text-gray-500">
                    Created: ${new Date(ticket.createdAt).toLocaleDateString()}
                </span>
                <div class="space-x-2">
                    <button onclick="editTicket(${ticket.id})" 
                            class="px-3 py-1 text-sm bg-blue-100 text-blue-800 rounded hover:bg-blue-200">
                        Edit
                    </button>
                    <button onclick="deleteTicket(${ticket.id})" 
                            class="px-3 py-1 text-sm bg-red-100 text-red-800 rounded hover:bg-red-200">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    `).join('');
}

function getStatusClass(status) {
    switch (status) {
        case 'open':
            return 'bg-green-100 text-green-800';
        case 'in_progress':
            return 'bg-yellow-100 text-yellow-800';
        case 'closed':
            return 'bg-gray-100 text-gray-800';
        default:
            return '';
    }
}

function openNewTicketModal() {
    document.getElementById('modalTitle').textContent = 'Create New Ticket';
    document.getElementById('ticketForm').reset();
    document.getElementById('ticketId').value = '';
    document.getElementById('ticketModal').classList.remove('hidden');
}

function closeTicketModal() {
    document.getElementById('ticketModal').classList.add('hidden');
}

function editTicket(id) {
    const tickets = JSON.parse(localStorage.getItem('tickets')) || [];
    const ticket = tickets.find(t => t.id === id);
    if (!ticket) return;

    document.getElementById('modalTitle').textContent = 'Edit Ticket';
    document.getElementById('ticketId').value = ticket.id;
    document.getElementById('ticketForm').elements.title.value = ticket.title;
    document.getElementById('ticketForm').elements.description.value = ticket.description || '';
    document.getElementById('ticketForm').elements.status.value = ticket.status;
    
    document.getElementById('ticketModal').classList.remove('hidden');
}

function deleteTicket(id) {
    ticketToDelete = id;
    document.getElementById('deleteModal').classList.remove('hidden');
}

function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
    ticketToDelete = null;
}

function confirmDelete() {
    if (ticketToDelete === null) return;

    let tickets = JSON.parse(localStorage.getItem('tickets')) || [];
    tickets = tickets.filter(t => t.id !== ticketToDelete);
    localStorage.setItem('tickets', JSON.stringify(tickets));
    
    closeDeleteModal();
    loadTickets();
}

document.getElementById('ticketForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(e.target);
    const ticketData = {
        id: parseInt(formData.get('id')) || Date.now(),
        title: formData.get('title'),
        description: formData.get('description'),
        status: formData.get('status'),
        createdAt: new Date().toISOString()
    };

    let tickets = JSON.parse(localStorage.getItem('tickets')) || [];
    
    if (formData.get('id')) {
        // Update existing ticket
        tickets = tickets.map(t => t.id === ticketData.id ? {...t, ...ticketData} : t);
    } else {
        // Add new ticket
        tickets.push(ticketData);
    }

    localStorage.setItem('tickets', JSON.stringify(tickets));
    closeTicketModal();
    loadTickets();
});
</script>
{% endblock %}
