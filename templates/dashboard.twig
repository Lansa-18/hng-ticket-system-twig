{% extends "base.twig" %}

{% block content %}
<!-- Header -->
<header class="bg-white shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center py-4 sm:py-6 gap-4 sm:gap-0">
            <div class="flex items-center w-full sm:w-auto justify-between sm:justify-start space-x-4 sm:space-x-8">
                <h2 class="text-xl sm:text-2xl font-bold text-gray-900">
                    TrackiT
                </h2>
                <nav class="flex sm:hidden">
                    <a href="/dashboard" class="text-gray-700 hover:text-blue-600 px-2 py-1 text-sm font-medium">
                        Dashboard
                    </a>
                    <a href="/tickets" class="text-gray-700 hover:text-blue-600 px-2 py-1 text-sm font-medium">
                        Tickets
                    </a>
                </nav>
            </div>

            <nav class="hidden sm:flex space-x-4">
                <a href="/dashboard" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium">
                    Dashboard
                </a>
                <a href="/tickets" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium">
                    Tickets
                </a>
            </nav>

            <div class="flex items-center justify-between w-full sm:w-auto space-x-4">
                <span class="text-lg sm:text-xl font-bold text-gray-700 truncate" id="headerUserName"></span>
                <button onclick="logout()" 
                    class="inline-flex items-center px-3 py-2 sm:px-4 sm:py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</header>

<!-- Main Content -->
<main class="container max-w-7xl mx-auto p-4 sm:p-6 lg:p-8">
    <div class="space-y-4 sm:space-y-6">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-xl sm:text-2xl font-semibold text-gray-900">
                    Welcome back, <span id="welcomeUserName"></span>!
                </h1>
                <p class="mt-1 sm:mt-2 text-sm sm:text-base text-gray-600">
                    Here's an overview of your ticket management system.
                </p>
            </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
            <div class="bg-white shadow-sm rounded-lg p-4 sm:p-6">
                <h3 class="text-sm sm:text-lg font-medium text-gray-900">
                    Total Tickets
                </h3>
                <p class="text-2xl sm:text-3xl font-bold text-blue-900 mt-2" id="totalTickets">
                    ...
                </p>
            </div>
            <div class="bg-white shadow-sm rounded-lg p-4 sm:p-6">
                <h3 class="text-sm sm:text-lg font-medium text-gray-900">Open</h3>
                <p class="text-2xl sm:text-3xl font-bold text-green-600 mt-2" id="openTickets">
                    ...
                </p>
            </div>
            <div class="bg-white shadow-sm rounded-lg p-4 sm:p-6">
                <h3 class="text-sm sm:text-lg font-medium text-gray-900">
                    In Progress
                </h3>
                <p class="text-2xl sm:text-3xl font-bold text-yellow-600 mt-2" id="inProgressTickets">
                    ...
                </p>
            </div>
            <div class="bg-white shadow-sm rounded-lg p-4 sm:p-6">
                <h3 class="text-sm sm:text-lg font-medium text-gray-900">
                    Resolved
                </h3>
                <p class="text-2xl sm:text-3xl font-bold text-grey-700 mt-2" id="resolvedTickets">
                    ...
                </p>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-5 border-b border-gray-200">
            <div class="flex items-center justify-between">
                <h2 class="text-xl font-semibold text-gray-900">Recent Activity</h2>
                <a href="/tickets" class="text-blue-600 hover:text-blue-500 text-sm font-medium">
                    View All Tickets →
                </a>
            </div>
        </div>
        <div class="px-6 py-4" id="recentActivity">
            <p class="text-gray-500 text-center py-4">You have 1 open ticket that needs attention.</p>
        </div>
    </div>
</main>

<footer class="bg-gray-900 text-gray-300 mt-auto">
    <div class="container mx-auto px-4 py-12 max-w-[1440px]">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
                <h3 class="text-xl font-bold mb-4">TrackiT</h3>
                <p class="text-gray-400">
                    Streamline your support workflow with our powerful ticket
                    management solution.
                </p>
            </div>

            <div>
                <h4 class="text-lg font-semibold mb-4">Quick Links</h4>
                <ul class="space-y-2">
                    <li>
                        <a href="/" class="hover:text-white transition-colors">Home</a>
                    </li>
                    <li>
                        <a href="/login" class="hover:text-white transition-colors">Login</a>
                    </li>
                    <li>
                        <a href="/signup" class="hover:text-white transition-colors">Sign Up</a>
                    </li>
                </ul>
            </div>

            <div>
                <h4 class="text-lg font-semibold mb-4">Contact</h4>
                <ul class="space-y-2 text-gray-400">
                    <li>Email: support@trackiT.com</li>
                    <li>Phone: (555) 123-4567</li>
                </ul>
            </div>
        </div>

        <div class="border-t border-gray-800 mt-8 pt-8 text-center text-gray-400">
            <p>© {{ "now"|date("Y") }} TrackiT. All rights reserved.</p>
        </div>
    </div>
</footer>

<!-- New Ticket Modal -->
<div id="newTicketModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Create New Ticket</h3>
            <form id="newTicketForm" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Title</label>
                    <input type="text" name="title" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Description</label>
                    <textarea name="description" rows="3" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"></textarea>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Status</label>
                    <select name="status" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                        <option value="open">Open</option>
                        <option value="in_progress">In Progress</option>
                        <option value="closed">Closed</option>
                    </select>
                </div>
                <div class="flex justify-end space-x-3">
                    <button type="button" onclick="closeNewTicketModal()" class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Check authentication
    const session = localStorage.getItem('ticketapp_session');
    if (!session) {
        window.location.href = '/auth/login';
        return;
    }

    // Set user name in header and welcome message
    try {
        const data = JSON.parse(session);
        
        // Handle both data structures
        let userName;
        if (data.data && data.data.user) {
            // Demo user structure
            userName = data.data.user.name;
        } else if (data.user) {
            // Regular user structure
            userName = data.user.name;
        }
        
        if (userName) {
            document.getElementById('welcomeUserName').textContent = userName;
            document.getElementById('headerUserName').textContent = userName;
        } else {
            console.error('Could not find user name in session data');
        }
    } catch (err) {
        console.error('Error parsing session:', err);
        console.error('Session content:', session);
    }

    // Load tickets
    loadTickets();

    // Setup form submit handler
    document.getElementById('newTicketForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const formData = new FormData(e.target);
        const ticket = {
            id: Date.now(),
            title: formData.get('title'),
            description: formData.get('description'),
            status: formData.get('status'),
            createdAt: new Date().toISOString()
        };

        // Get existing tickets and add new one
        let tickets = JSON.parse(localStorage.getItem('tickets')) || [];
        tickets.push(ticket);
        localStorage.setItem('tickets', JSON.stringify(tickets));

        // Close modal and reload tickets
        closeNewTicketModal();
        loadTickets();
        e.target.reset();
    });
});

function loadTickets() {
    let tickets = JSON.parse(localStorage.getItem('tickets')) || [];
    
    // Update statistics
    document.getElementById('totalTickets').textContent = tickets.length;
    document.getElementById('openTickets').textContent = tickets.filter(t => t.status === 'open').length;
    document.getElementById('inProgressTickets').textContent = tickets.filter(t => t.status === 'in_progress').length;
    document.getElementById('resolvedTickets').textContent = tickets.filter(t => t.status === 'closed').length;

    // Update recent activity
    const recentActivity = document.getElementById('recentActivity');
    if (tickets.length > 0) {
        const openTickets = tickets.filter(t => t.status === 'open').length;
        const message = openTickets === 1 
            ? 'You have 1 open ticket that needs attention.'
            : openTickets === 0
                ? 'No tickets need attention right now.'
                : `You have ${openTickets} open tickets that need attention.`;
                
        recentActivity.innerHTML = `
            <p class="text-gray-600 text-center py-4">${message}</p>
            ${tickets.slice(0, 5).map(ticket => `
                <div class="border-t border-gray-200 py-4 first:border-t-0">
                    <div class="flex justify-between items-center">
                        <div>
                            <h3 class="text-sm font-medium text-gray-900">${ticket.title}</h3>
                            <p class="text-sm text-gray-500 mt-1">${ticket.description || 'No description'}</p>
                        </div>
                        <span class="px-2.5 py-1 text-xs font-medium rounded-full ${getStatusClass(ticket.status)}">
                            ${ticket.status.replace('_', ' ')}
                        </span>
                    </div>
                </div>
            `).join('')}
        `;
    } else {
        recentActivity.innerHTML = '<p class="text-gray-500 text-center py-4">No tickets yet. Create your first ticket to get started!</p>';
    }
}

function getStatusClass(status) {
    switch (status) {
        case 'open':
            return 'bg-green-100 text-green-800';
        case 'in_progress':
            return 'bg-yellow-100 text-yellow-800';
        case 'closed':
            return 'bg-gray-100 text-gray-800';
        default:
            return '';
    }
}

function logout() {
    // Make the logout request
    fetch('/auth/logout', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Clear all app-related data
            localStorage.removeItem('ticketapp_session');
            localStorage.removeItem('tickets');
            localStorage.removeItem('userData');
            
            // Redirect to login page
            window.location.href = data.redirect;
        }
    })
    .catch(error => {
        console.error('Logout error:', error);
        // Fallback logout
        localStorage.removeItem('ticketapp_session');
        localStorage.removeItem('tickets');
        localStorage.removeItem('userData');
        window.location.href = '/';
    });
}

function openNewTicketModal() {
    document.getElementById('newTicketModal').classList.remove('hidden');
}

function closeNewTicketModal() {
    document.getElementById('newTicketModal').classList.add('hidden');
}
</script>
{% endblock %}
