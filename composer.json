{
  "name": "ticket-system/twig",
  "description": "Ticket Management System using Twig",
  "type": "project",
  "require": {
    "php": ">=7.4",
    "twig/twig": "^3.0",
    "bramus/router": "^1.6",
    "ext-json": "*"
  },
  "require-dev": {
    "heroku/heroku-buildpack-php": "^233.0.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "npm install",
      "npm run build"
    ]
  },
  "engines": {
    "php": ">=7.4",
    "node": ">=14"
  }
}
